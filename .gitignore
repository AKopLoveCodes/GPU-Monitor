# macOS / editor noise
.DS_Store

# Per-machine configuration; commit config.example.json instead
/config.json

# Local runtime state: logs, PID/lock files, SSH control sockets
.runtime/

# Downloaded official exporter binary and its license (scripts/bootstrap.py)
.tools/

# Locally generated reports and application materials
/output/

# Local review and test reports (keep files locally, outside version control)
/docs/*REPORT*.md
/docs/*report*.md

__pycache__/
*.pyc

# Optional user-supplied wallpapers; see README "Appearance"
web/assets/*.jpg
web/assets/*.jpeg
web/assets/*.png
web/assets/*.webp

# Local Claude Code settings (launch.json is committed for the mock preview)
.claude/settings*.json
